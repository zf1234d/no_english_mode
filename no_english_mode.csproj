<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NoEnglishMode</RootNamespace>
    <AssemblyName>no_english_mode</AssemblyName>
    <Version>1.0.2</Version>
    <AssemblyTitle>NoEnglishMode</AssemblyTitle>
    <Product>NoEnglishMode</Product>
    <Description>保持微软拼音输入法处于中文模式</Description>
    <Company>zf1234d</Company>
    <Copyright>Copyright © 2026 zf1234d</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the project build on machines without the .NET Framework 4.8
         Developer Pack (compile-time reference assemblies only). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
